generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id           String       @id @default(cuid())
  name         String
  title        String?
  active       Boolean      @default(true)
  displayOrder Int          @default(0)
  assignments  Assignment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([active, displayOrder])
  @@map("TurfEmployee")
}

model DailyPlan {
  id                                 String       @id @default(cuid())
  date                               String       @unique
  notes                              String?
  weather                            String?
  startTime                          String?
  greensWalkHeight                   String?
  greensTriplexHeight                String?
  greensCleanupHeight                String?
  tcaTeesHeight                      String?
  tcaCollarsApproachesFairwaysHeight String?
  roughHeight                        String?
  roughSecondaryCutHeight            String?
  greensCutDirection                 String?
  approachesCutDirection             String?
  teesCutDirection                   String?
  fairwaysCutDirection               String?
  assignments                        Assignment[]
  createdAt                          DateTime     @default(now())
  updatedAt                          DateTime     @updatedAt
}

model HeightOfCutDefault {
  id                                 String   @id @default("default")
  greensWalkHeight                   String?
  greensTriplexHeight                String?
  greensCleanupHeight                String?
  tcaTeesHeight                      String?
  tcaCollarsApproachesFairwaysHeight String?
  roughHeight                        String?
  roughSecondaryCutHeight            String?
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt
}

model Assignment {
  id         String    @id @default(cuid())
  planId     String
  employeeId String
  title      String
  plan       DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([planId, employeeId])
  @@index([employeeId, createdAt])
  @@map("JobAssignment")
}
