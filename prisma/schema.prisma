generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Employee {
  id           String       @id @default(cuid())
  name         String
  title        String?
  active       Boolean      @default(true)
  displayOrder Int          @default(0)
  assignments  Assignment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([active, displayOrder])
  @@map("TurfEmployee")
}

model DailyPlan {
  id                                 String       @id @default(cuid())
  date                               String       @unique
  notes                              String?
  weather                            String?
  greensWalkHeight                   Decimal?     @db.Decimal(5, 3)
  greensTriplexHeight                Decimal?     @db.Decimal(5, 3)
  greensCleanupHeight                Decimal?     @db.Decimal(5, 3)
  tcaTeesHeight                      Decimal?     @db.Decimal(5, 3)
  tcaCollarsApproachesFairwaysHeight Decimal?     @db.Decimal(5, 3)
  roughHeight                        Decimal?     @db.Decimal(5, 3)
  roughSecondaryCutHeight            Decimal?     @db.Decimal(5, 3)
  assignments                        Assignment[]
  createdAt                          DateTime     @default(now())
  updatedAt                          DateTime     @updatedAt
}

model Assignment {
  id         String    @id @default(cuid())
  planId     String
  employeeId String
  title      String
  plan       DailyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([planId, employeeId])
  @@index([employeeId, createdAt])
  @@map("JobAssignment")
}
